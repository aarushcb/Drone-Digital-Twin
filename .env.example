# Copy this file to .env and fill in real values. .env is never committed to git.

# Local dev default — leave as-is to use a local SQLite file (drone_twin.db).
# Later, replace with your Supabase/Neon connection string, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./drone_twin.db

# Generate a real random value for this before deploying anywhere public.
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-change-this-before-deploying
